---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { articles } from '../../data/articles.ts';
import { formatDate } from '../../lib/format.ts';
import { breadcrumbs, graph, article as articleLd } from '../../lib/seo.ts';

export function getStaticPaths() {
	return articles.map( ( a ) => ( { params: { slug: a.slug }, props: { a } } ) );
}

const { a } = Astro.props;
const path = `/articles/${ a.slug }/`;
const trail = [ { name: 'الرئيسية', path: '/' }, { name: 'مقالات', path: '/articles/' }, { name: a.title, path } ];
const updated = formatDate( a.updated );
---
<Layout title={ a.title } description={ a.description } path={ path } type="article" jsonld={ graph( breadcrumbs( trail ), articleLd( { title: a.title, description: a.description, path, updated: a.updated } ) ) }>
	<Breadcrumbs trail={ trail } />
	<header class="page-h">
		<span class="kicker">📖 مقال</span>
		<h1>{ a.title }</h1>
		<p class="lead">{ a.lead }</p>
		<div class="meta-row"><span>حُدّث <time datetime={ a.updated }>{ updated }</time></span></div>
	</header>
	<article class="prose">
		{ a.sections.map( ( s, i ) => (
			<>
				<section><h2>{ s.h }</h2>{ s.p.map( ( p ) => <p>{ p }</p> ) }</section>
				{ i === 2 && <AdSlot slot="inArticle" /> }
			</>
		) ) }
		<h2>اقرأ أيضاً</h2>
		<ul>{ a.links.map( ( l ) => <li><a href={ l.href }>{ l.text }</a></li> ) }</ul>
	</article>
</Layout>
