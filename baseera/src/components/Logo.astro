	<circle cx="24" cy="24" r="2.3" fill="var(--color-primary)" />
	{ rays && <path d="M24 9v3M24 36v3M9 24H6M42 24h-3" stroke="var(--color-primary)" stroke-width="1.6" stroke-linecap="round" /> }
</svg>
