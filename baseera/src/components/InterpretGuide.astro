---
/**
 * دليل قراءة النتائج — كل المستويات مكتوبة قبل الاختبار.
 *
 * يُنشر مسبقاً لسببين: أن يعرف الزائر ما سيحصل عليه قبل أن يبدأ، وأن
 * تجيب الصفحة عن أسئلة يبحث عنها الناس مباشرةً («ماذا تعني الدرجة
 * المنخفضة في…؟»).
 *
 * يُعرض بطاقات تُسحب أفقياً: مستوى في كل بطاقة، وجملته الأولى ظاهرة،
 * وباقي الشرح بنقرة. النصّ كلّه في الصفحة.
 */
import type { Subscale } from '../lib/types.ts';
import { num } from '../lib/format.ts';
import { splitLead } from '../lib/text.ts';

interface Props { scales: Subscale[] }
const { scales } = Astro.props;

const range = ( s: Subscale, i: number ) => {
	const from = i === 0 ? s.min : s.bands[ i - 1 ].upTo + ( s.scoring === 'mean' ? 0.01 : 1 );
	const to = s.bands[ i ].upTo;
	const fmt = ( n: number ) => num( s.scoring === 'mean' ? n.toFixed( 2 ).replace( /\.?0+$/, '' ) : String( Math.round( n ) ) );

	return from === to ? fmt( to ) : `${ fmt( from ) }–${ fmt( to ) }`;
};
---
<section class="guide" aria-labelledby="guide-h">
	<h2 id="guide-h">دليل قراءة النتائج <small>اسحب ←</small></h2>
	{ scales.map( ( s ) => (
		<div class="scale">
			{ scales.length > 1 && <h3>{ s.name }</h3> }
			{ s.about && <p>{ s.about }</p> }
			<div class="bands" role="list">
				{ s.bands.map( ( b, i ) => {
					const [ lead, rest ] = splitLead( b.text );

					return (
						<div class:list={ [ 'band', `t-${ b.tone }` ] } role="listitem">
							<b>{ b.label }{ ! s.uncalibrated && <span class="rng num">{ range( s, i ) }</span> }</b>
							<p>{ lead }</p>
							{ rest && <details><summary>المزيد</summary><p>{ rest }</p></details> }
						</div>
					);
				} ) }
			</div>
		</div>
	) ) }
</section>
