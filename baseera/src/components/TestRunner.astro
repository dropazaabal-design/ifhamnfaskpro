---
/**
 * مشغّل الاختبار: الهيكل على الخادم، والتفاعل في المتصفّح.
 *
 * بيانات الاختبار تُطبع JSON في وسم application/json لا في سكربت مضمّن،
 * فلا يعترضها Content-Security-Policy ولا تُنفَّذ. والتصحيح كلّه على جهاز
 * الزائر: لا إجابة تغادره.
 */
import type { Test } from '../lib/types.ts';
import { countNoun, QUESTIONS, STATEMENTS, MINUTES } from '../lib/format.ts';
import { splitLead } from '../lib/text.ts';
import { SITE } from '../config.ts';

interface Props { test: Test }
const { test } = Astro.props;

// «<» يُهرَّب كي لا يُغلق نصٌّ داخل البيانات وسمَ script.
const [ instrLead, instrRest ] = splitLead( test.instructions );

// الوعد على قدر ما نملك: هامش الخطأ لا يُعرض حيث لم يُقَس الثبات.
const calibrated = test.subscales.some( ( s ) => ! s.uncalibrated );
const honest = calibrated
	? 'النتيجة تقدير لا حكم: سنعرض لك معها هامش الخطأ، ونخبرك إن بدت إجاباتك متسرّعة.'
	: test.kind === 'task'
		? 'النتيجة تقدير لا حكم: أداؤك في جلسة واحدة يتأثّر بالتعب والتشتّت والجهاز. هذه النسخة لم يُقَس ثباتها، فلن نعرض هامش خطأ مُخترَعاً ولن نقارنك بأحد.'
		: 'النتيجة تقدير لا حكم: هذه الأسئلة لم يُقَس ثباتها بعد، فلن نعرض هامش خطأ مُخترَعاً ولن نقارنك بأحد — وسنشرح لك كل جواب.';

const json = JSON.stringify( { ...test, article: undefined, faq: undefined } ).replace( /</g, '\\u003c' );
---
<section class="runner card" data-runner data-slug={ test.slug } data-site={ SITE.url } aria-live="polite">
	<div data-screen="start">
		<p class="runner__meta">
			{ test.kind === 'task'
				? <span class="mchip">🎮 <b>مهمّة تفاعلية</b></span>
				: <span class="mchip">📝 <b>{ countNoun( test.items.length, test.kind === 'choice' ? QUESTIONS : STATEMENTS ) }</b></span> }
			<span class="mchip">⏱️ نحو <b>{ countNoun( test.minutes, MINUTES, 'gen' ) }</b></span>
			<span class="mchip">🔒 على جهازك</span>
		</p>
		<p class="runner__instr">{ instrLead }</p>
		{ instrRest && <details class="runner__more"><summary>التعليمات كاملة</summary><p>{ instrRest }</p></details> }
		{ test.setup && (
			<label class="runner__setup">
				<span>{ test.setup.label }</span>
				<input type="text" data-setup maxlength="60" autocomplete="off" placeholder={ test.setup.placeholder } />
				<small>🔒 تبقى على جهازك: تُكتب في الأسئلة ولا تُرسل.</small>
			</label>
		) }
		<details class="runner__honest">
			<summary>⚖️ <b>تقدير لا حكم</b> — { calibrated ? 'مع هامش الخطأ' : 'بلا أرقام مُخترَعة' }</summary>
			<p>{ honest }</p>
		</details>
		<button type="button" class="btn btn--primary btn--block" data-start>
			ابدأ الاختبار
			<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
		</button>
		<p class="runner__resume" data-resume hidden>
			لديك إجابات لم تكتمل في هذا الاختبار. <button type="button" class="linkish" data-resume-go>أكمل من حيث توقّفت</button>
		</p>
	</div>

	<div data-screen="question" hidden>
		<div class="runner__bar" aria-hidden="true"><span data-bar></span></div>
		<p class="runner__count"><span class="num" data-count></span><span class="runner__cheer" data-cheer aria-live="polite"></span></p>
		<fieldset class="runner__q">
			<legend data-question></legend>
			<div data-figure class="runner__figure"></div>
			<div class="runner__opts" data-options></div>
		</fieldset>
		<div class="runner__nav">
			<button type="button" class="btn btn--ghost" data-back>السابق</button>
		</div>
	</div>

	<div data-screen="task" hidden></div>

	<div data-screen="result" hidden tabindex="-1"></div>

	<script type="application/json" data-test set:html={ json } />
	<noscript><p class="runner__instr">هذا الاختبار يحتاج JavaScript ليعمل، لأن التصحيح يحدث على جهازك لا على خادم.</p></noscript>
</section>

<style is:global>
	.runner { margin-top: 22px; padding: 20px; box-shadow: var(--shadow); }
	.runner__meta { display: flex; flex-wrap: wrap; gap: 7px; font-size: 12.5px; color: var(--color-text-muted); }
	.runner__meta b { color: var(--color-text); }
	.mchip { padding: 4px 11px; border-radius: 100px; background: var(--color-surface-2); white-space: nowrap; }
	.runner__more { margin: -8px 0 14px; font-size: 13.5px; line-height: 1.9; }
	.runner__more summary, .runner__honest summary { cursor: pointer; color: var(--color-primary); font-weight: 700; font-size: 12.5px; list-style: none; }
	.runner__more summary::-webkit-details-marker, .runner__honest summary::-webkit-details-marker { display: none; }
	.runner__more p { margin-top: 6px; color: var(--color-text-muted); }
	.runner__setup { display: grid; gap: 6px; margin-bottom: 14px; font-size: 14px; font-weight: 700; }
	.runner__setup input { font: inherit; font-weight: 600; padding: 12px 14px; border-radius: 12px; border: 1.5px solid var(--color-border); background: var(--color-surface); color: var(--color-text); }
	.runner__setup input:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-ring); }
	.runner__setup small { font-size: 11.5px; font-weight: 400; color: var(--color-text-muted); }
	.runner__instr { font-size: 14.5px; line-height: 1.9; margin: 12px 0 16px; }
	.runner__honest { font-size: 12.5px; line-height: 1.8; color: var(--color-text-muted); background: var(--color-bg); border: 1px dashed var(--color-border-strong); border-radius: 12px; padding: 8px 12px; margin-bottom: 14px; }
	.runner__honest summary { color: var(--color-text-muted); font-weight: 400; }
	.runner__honest summary b { color: var(--color-text); }
	.runner__honest p { margin-top: 4px; }
	.runner__resume { font-size: 13px; color: var(--color-text-muted); margin-top: 12px; text-align: center; }
	.linkish { background: none; border: 0; color: var(--color-primary); font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
	.runner__bar { height: 6px; background: var(--color-surface-2); border-radius: 100px; overflow: hidden; }
	.runner__bar span { display: block; height: 100%; width: 0; background: var(--color-primary); border-radius: 100px; transition: width .25s ease; }
	.runner__count { display: flex; justify-content: space-between; align-items: center; min-height: 22px; font-size: 12.5px; font-weight: 700; color: var(--color-text-muted); margin-top: 10px; }
	.runner__cheer { font-size: 12.5px; color: var(--color-primary); font-weight: 800; }
	.runner__cheer:not(:empty) { animation: pop .3s ease; }
	@keyframes pop { from { transform: scale(.8); opacity: 0; } to { transform: none; opacity: 1; } }
	@media (prefers-reduced-motion: reduce) { .runner__cheer:not(:empty) { animation: none; } }
	.runner__q { border: 0; margin-top: 8px; min-width: 0; }
	.runner__q legend { font-size: 19px; font-weight: 800; line-height: 1.75; padding: 0; text-wrap: balance; }
	.runner__figure:empty { display: none; }
	.runner__figure { margin: 16px auto 4px; display: grid; place-items: center; color: var(--color-text); }
	.runner__figure svg { width: min(100%, 236px); height: auto; }
	.runner__opts { display: grid; gap: 9px; margin-top: 16px; }
	.runner__opts.figs { grid-template-columns: repeat(4, 1fr); }
	.opt { position: relative; display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 12px 16px; border-radius: 13px; border: 1.5px solid var(--color-border); background: var(--color-surface); cursor: pointer; font-size: 15px; font-weight: 600; line-height: 1.5; transition: border-color .14s, background .14s; color: var(--color-text); }
	.opt:hover { border-color: var(--color-border-strong); }
	.opt input { position: absolute; opacity: 0; pointer-events: none; }
	.opt .k { flex-shrink: 0; width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; font-family: var(--font-num); font-size: 12px; font-weight: 700; background: var(--color-surface-2); color: var(--color-text-muted); }
	.opt:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary-soft); }
	.opt:has(input:checked) .k { background: var(--color-primary); color: var(--color-primary-contrast); }
	.opt:has(input:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 2px; }
	.opt--fig { flex-direction: column; justify-content: center; padding: 10px 4px; color: var(--color-text); }
	.opt--fig { gap: 6px; }
	.opt--fig .k { width: 20px; height: 20px; font-size: 11px; border-radius: 6px; }
	.opt--fig svg { width: 100%; max-width: 64px; height: auto; }
	/* مقياس 0–10: صفّ أرقام بطرفين موسومين، كما في استبيانات Dohmen وزملائه. */
	.runner__opts.scale { gap: 6px; }
	.scale-row { display: grid; grid-template-columns: repeat(11, 1fr); gap: 4px; }
	.opt--num { justify-content: center; min-height: 46px; padding: 0; border-radius: 10px; font-family: var(--font-num); font-size: 15px; font-weight: 700; }
	.scale-ends { display: flex; justify-content: space-between; gap: 12px; font-size: 11.5px; color: var(--color-text-muted); line-height: 1.5; }
	.scale-ends span { max-width: 45%; }
	.scale-ends span:last-child { text-align: end; }
	.runner__nav { display: flex; justify-content: space-between; margin-top: 18px; }

	/* النتيجة */
	.res h2 { font-family: var(--font-display); font-size: 22px; font-weight: 700; }
	.res .scale { margin-top: 20px; }
	.res .scale h3 { font-size: 15px; font-weight: 800; display: flex; justify-content: space-between; gap: 10px; align-items: baseline; }
	.res .scale h3 .num { font-size: 22px; color: var(--tone); }
	.res .band-label { display: inline-block; font-size: 12.5px; font-weight: 800; padding: 3px 10px; border-radius: 100px; color: var(--tone); background: color-mix(in srgb, var(--tone) 12%, transparent); margin-top: 6px; }
	.meter { position: relative; height: 12px; border-radius: 100px; background: var(--color-surface-2); margin-top: 12px; }
	.meter .ci { position: absolute; top: 0; bottom: 0; border-radius: 100px; background: color-mix(in srgb, var(--tone) 28%, transparent); }
	.meter .pt { position: absolute; top: 50%; width: 16px; height: 16px; border-radius: 50%; background: var(--tone); border: 3px solid var(--color-surface); transform: translate(-50%, -50%); box-shadow: var(--shadow-sm); }
	/* الحدّ الأدنى يميناً كما تُقرأ العربية، وكما يُرسم الشريط وصورة القصص. */
	.meter-axis { display: flex; justify-content: space-between; font-size: 11px; color: var(--color-text-muted); margin-top: 4px; }
	.res .scale p { font-size: 14.5px; line-height: 1.95; margin-top: 10px; }
	.chips { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 6px; }
	.res .chips .band-label { margin-top: 0; }
	.rng-chip { font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 100px; background: var(--color-surface-2); color: var(--color-text-muted); font-family: var(--font-num); direction: ltr; unicode-bidi: isolate; }
	.res .lead-line { font-weight: 600; }
	details.more { margin-top: 4px; }
	details.more summary, details.solutions > summary { cursor: pointer; font-size: 13px; font-weight: 800; color: var(--color-primary); list-style: none; display: inline-flex; gap: 4px; align-items: center; }
	details.more summary::after, details.solutions > summary::after { content: '▾'; font-size: 11px; transition: transform .15s; }
	details.more[open] summary::after, details.solutions[open] > summary::after { transform: rotate(180deg); }
	details.more summary::-webkit-details-marker, details.solutions > summary::-webkit-details-marker { display: none; }
	details.more p { margin-top: 6px !important; color: var(--color-text-muted); }
	.typology { margin-top: 20px; padding: 16px; border-radius: 16px; background: var(--color-primary-soft); border: 1px solid var(--color-border); }
	.typology .kick { font-size: 11.5px; font-weight: 800; color: var(--color-primary); }
	.typology h3 { font-family: var(--font-display); font-size: 20px; margin-top: 2px; }
	.typology p { font-size: 14px; line-height: 1.9; margin-top: 6px; }
	.typology .fine { font-size: 12px; color: var(--color-text-muted); }
	.trust { margin-top: 22px; border: 1px solid var(--color-border); border-radius: 16px; padding: 13px 16px; background: var(--color-bg); }
	.trust > summary { cursor: pointer; list-style: none; display: grid; gap: 8px; }
	.trust > summary::-webkit-details-marker { display: none; }
	.t-title { font-size: 14.5px; font-weight: 800; display: flex; justify-content: space-between; align-items: center; }
	.t-title::after { content: 'التفاصيل ▾'; font-size: 12px; font-weight: 700; color: var(--color-primary); }
	.trust[open] .t-title::after { content: 'إخفاء ▴'; }
	.tchips { display: flex; flex-wrap: wrap; gap: 6px; }
	.tchip { font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 100px; background: var(--color-surface-2); color: var(--color-text); }
	.tchip.ok { background: var(--tone-ok-soft); color: var(--tone-low); }
	.tchip.warn { background: var(--tone-warn-soft); color: var(--tone-warn); }
	.trust ul { list-style: none; display: grid; gap: 9px; margin-top: 12px; }
	.trust li { font-size: 13.5px; line-height: 1.85; display: grid; grid-template-columns: 20px 1fr; gap: 6px; }
	.trust li .i { font-size: 14px; line-height: 1.7; }
	.trust .caution-line { color: var(--tone-warn); font-weight: 600; }
	.change { margin-top: 10px; font-size: 13px; line-height: 1.8; padding: 9px 12px; border-radius: 10px; background: var(--color-surface-2); }
	.change b { font-family: var(--font-num); }
	.trap-line { margin-top: 20px; font-size: 15px; font-weight: 700; padding: 12px 14px; border-radius: 12px; background: var(--tone-warn-soft); }
	.trap-line b { font-size: 18px; }
	details.solutions { margin-top: 14px; }
	.answers { margin-top: 12px; display: grid; gap: 10px; }
	.answers details { border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); }
	.answers summary { cursor: pointer; padding: 12px 14px; font-size: 14px; font-weight: 700; display: flex; gap: 8px; align-items: flex-start; }
	.answers summary .mark { flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 800; }
	.answers .ok { background: var(--tone-ok-soft); color: var(--tone-low); }
	.answers .no { background: var(--tone-alert-soft); color: var(--tone-alert); }
	.answers .body { padding: 0 14px 13px; font-size: 13.5px; line-height: 1.9; color: var(--color-text-muted); }
	.answers .body b { color: var(--color-text); }
	.share { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; margin-top: 18px; }
	.share .btn { min-height: 46px; font-size: 14px; }
	.share .wide { grid-column: 1 / -1; }
	.save-note { font-size: 12px; color: var(--color-text-muted); text-align: center; margin-top: 8px; line-height: 1.7; }
	/* المهامّ التفاعلية */
	.task { display: grid; gap: 14px; }
	.task__phase { font-size: 13px; font-weight: 700; color: var(--color-text-muted); text-align: center; }
	.task__stage { min-height: 132px; display: grid; place-items: center; font-size: 72px; font-weight: 700; border-radius: 18px; background: var(--color-bg); border: 1px solid var(--color-border); transition: background .15s; }
	.task__stage:not(:empty):not(.is-ok):not(.is-no) { font-variant-numeric: tabular-nums; }
	.task__stage.msg { font-size: 19px; font-weight: 800; color: var(--color-text-muted); }
	.task__stage.is-ok { color: var(--tone-low); background: var(--tone-ok-soft); }
	.task__stage.is-no { color: var(--tone-alert); background: var(--tone-alert-soft); }
	.task__typed { display: block; text-align: center; font-size: 26px; font-weight: 700; letter-spacing: 2px; min-height: 40px; }
	.keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; direction: ltr; margin-top: 8px; }
	.key { min-height: 54px; border-radius: 12px; border: 1.5px solid var(--color-border); background: var(--color-surface); font-size: 22px; font-weight: 700; cursor: pointer; touch-action: manipulation; }
	.key:active { background: var(--color-primary-soft); border-color: var(--color-primary); }
	.key--ok { grid-column: span 2; background: var(--color-primary); color: var(--color-primary-contrast); border-color: var(--color-primary); font-family: var(--font-body); font-size: 17px; }
	.task__gate { display: grid; gap: 10px; font-size: 14.5px; line-height: 1.9; }
	.task__gate .fine { font-size: 12.5px; color: var(--color-text-muted); }
	.sart { width: 100%; aspect-ratio: 1.3; max-height: 300px; border-radius: 22px; border: 2px solid var(--color-border-strong); background: var(--color-bg); display: grid; place-items: center; cursor: pointer; touch-action: manipulation; user-select: none; -webkit-user-select: none; transition: background .08s; }
	.sart.hit { background: var(--color-primary-soft); border-color: var(--color-primary); }
	.sart__digit { font-weight: 700; line-height: 1; color: var(--color-text); }
	.task__bar { height: 5px; background: var(--color-surface-2); border-radius: 100px; overflow: hidden; }
	.task__bar span { display: block; height: 100%; width: 0; background: var(--color-primary); }
	.task-details { list-style: none; margin-top: 14px; display: grid; gap: 6px; font-size: 13.5px; padding: 12px 14px; border-radius: 12px; background: var(--color-surface-2); }
	.task-details li::before { content: '• '; color: var(--color-primary); font-weight: 800; }
	.toast { position: fixed; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); left: 50%; transform: translateX(-50%); background: var(--color-text); color: var(--color-bg); padding: 10px 16px; border-radius: 100px; font-size: 13px; font-weight: 700; z-index: 60; box-shadow: var(--shadow-lg); }
</style>

<script>
	import '../scripts/runner.ts';
</script>
