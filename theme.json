{
  "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "780px",
      "wideSize": "1280px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "ink", "name": "كحلي عميق", "color": "#0F1E33" },
        { "slug": "cream", "name": "كريمي", "color": "#FAF9F7" },
        { "slug": "surface", "name": "أبيض", "color": "#FFFFFF" },
        { "slug": "line", "name": "حدود", "color": "#E7E5E1" },
        { "slug": "body", "name": "نص المتن", "color": "#4B5563" },
        { "slug": "faint", "name": "نص ثانوي", "color": "#6B7280" },
        { "slug": "cta", "name": "زر الشراء", "color": "#C2410C" },
        { "slug": "accent", "name": "لمسة", "color": "#EA580C" },
        { "slug": "amber", "name": "كهرماني", "color": "#F59E0B" },
        { "slug": "sale", "name": "خصم", "color": "#B91C1C" },
        { "slug": "success", "name": "نجاح", "color": "#15803D" },
        { "slug": "info", "name": "معلومة", "color": "#0E7490" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "dropCap": false,
      "fluid": true,
      "lineHeight": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "خط المتجر",
          "fontFamily": "var(--mp-font-sans)"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "صغير", "size": "0.8125rem" },
        { "slug": "medium", "name": "عادي", "size": "0.9375rem" },
        { "slug": "large", "name": "كبير", "size": "1.3125rem" },
        { "slug": "x-large", "name": "عنوان", "size": "1.625rem" },
        { "slug": "xx-large", "name": "عنوان رئيسي", "size": "2.125rem" }
      ]
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "em", "rem", "%", "vw"]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream)",
      "text": "var(--wp--preset--color--body)"
    },
    "typography": {
      "fontFamily": "var(--mp-font-sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.9"
    },
    "elements": {
      "heading": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        "typography": { "fontWeight": "700", "lineHeight": "1.4" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--cta)" },
        "typography": { "textDecoration": "underline" },
        ":hover": { "typography": { "textDecoration": "none" } }
      },
      "button": {
        "border": { "radius": "12px" },
        "color": {
          "background": "var(--mp-cta-solid)",
          "text": "var(--mp-cta-fg-solid)"
        },
        "typography": { "fontWeight": "700" },
        "spacing": { "padding": { "top": "0.9rem", "bottom": "0.9rem", "left": "1.4rem", "right": "1.4rem" } }
      }
    }
  }
}
